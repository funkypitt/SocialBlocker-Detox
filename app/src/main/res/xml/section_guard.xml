<?xml version="1.0" encoding="utf-8"?>
<!-- The guard of the sections. The packages are set at run time from the rules file
     (SectionGuardService.applyInfo); the event types and flags are repeated there too. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewSelected"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="false"
    android:notificationTimeout="300"
    android:description="@string/sec_service_desc"
    android:packageNames="com.whatsapp,com.lemon.lvoverseas"
    android:settingsActivity="com.parentcontrol.socialblocker.MainActivity" />
